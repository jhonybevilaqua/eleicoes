__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/

# Dados operacionais (nao versionar)
dados/saida/*
dados/estado/*
!dados/saida/.gitkeep
!dados/estado/.gitkeep
# Apenas a config em uso na maquina e as copias locais. Os modelos
# versionados (example, recomendado, validacao-*) precisam ficar no repo.
config/config.yaml
config/config.local*.yaml
logs/

# Empacotamento
build/
dist/
.venv-build/
*.spec

# o PDF das tarjas e gerado, mas vai versionado para circular sem build
!tarjas/*.pdf

# gctse GRAFICOS: cores atribuidas na maquina
graficos/cores-atribuidas-*.json

# gctse GRAFICOS: perfis do navegador da apresentacao
graficos/navegador-*/

# gctse GRAFICOS: backup local do PREPARAR-WINDOWS
graficos/windows-antes.json

# gctse GRAFICOS: arquivos gerados na maquina
graficos/gerenciador-estado.json
graficos/ENDERECOS-OBS.txt
graficos/obs-saidas.json

# gctse GRAFICOS: pasta do ENSAIO.bat e copias de seguranca (geradas na maquina)
graficos/ensaio/
graficos/copias-de-seguranca/
graficos/copia-seguranca.json
graficos/config-graficos.ANTES-2T.json
graficos/tse-local/
graficos/web/fotos-tse/
graficos/GUARDAR-DADOS-TSE.txt

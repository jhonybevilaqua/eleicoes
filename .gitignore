__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
.pytest_cache/
.mypy_cache/

# Dados operacionais (nao versionar)
dados/saida/*
dados/estado/*
!dados/saida/.gitkeep
!dados/estado/.gitkeep
# Apenas a config em uso na maquina e as copias locais. Os modelos
# versionados (example, recomendado, validacao-*) precisam ficar no repo.
config/config.yaml
config/config.local*.yaml
logs/

# Empacotamento
build/
dist/
.venv-build/
*.spec

# o PDF das tarjas e gerado, mas vai versionado para circular sem build
!tarjas/*.pdf
